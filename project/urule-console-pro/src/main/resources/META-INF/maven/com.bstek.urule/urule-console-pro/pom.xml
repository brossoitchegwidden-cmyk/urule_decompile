<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.bstek.urule</groupId>
		<artifactId>urule-parent-pro</artifactId>
		<version>2.0.6</version>
	</parent>
	<artifactId>urule-console-pro</artifactId>
	<version>4.3.0</version>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<dependencies>
		<dependency>
			<groupId>com.bstek.urule</groupId>
			<artifactId>urule-core-pro</artifactId>
			<version>4.3.0</version>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>servlet-api</artifactId>
			<version>2.5</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>commons-fileupload</groupId>
			<artifactId>commons-fileupload</artifactId>
			<version>1.4</version>
		</dependency>
		<dependency>
			<groupId>org.apache.velocity</groupId>
			<artifactId>velocity</artifactId>
			<version>1.7</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>3.16</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-dbcp2</artifactId>
			<version>2.8.0</version>
		</dependency>
		<dependency>
			<groupId>org.hsqldb</groupId>
			<artifactId>hsqldb</artifactId>
			<version>2.5.0</version>
		</dependency>
		<dependency>
			<groupId>javax.mail</groupId>
			<artifactId>mail</artifactId>
			<version>1.4.7</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>com.github.wvengen</groupId>
				<artifactId>proguard-maven-plugin</artifactId>
				<version>2.3.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>proguard</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<proguardVersion>6.2.2</proguardVersion>
					<obfuscate>true</obfuscate>
					<injar>${project.build.finalName}.jar</injar>
					<outjar>${project.build.finalName}.jar</outjar>
					<addMavenDescriptor>true</addMavenDescriptor>
					<libs>
						<lib>${java.home}/lib/rt.jar</lib>
					</libs>
					<options>
						<option>-target 1.8</option>
						<option>-dontshrink</option>
						<option>-dontoptimize</option>
						<option>-ignorewarnings</option>
						<option>-keeppackagenames</option>
						<option>-dontnote</option>
						<option>-keepnames class **</option>
						<option>-keepnames interface **</option>
						<option>-keepattributes
							Exceptions,SourceFile,LineNumberTable,InnerClasses,Signature,Deprecated,*Annotation*,EnclosingMethod</option>
						<option>-keep class com.bstek.urule.model.** {*;}</option>
						<option>-keep class
							com.bstek.urule.runtime.KnowledgePackageImpl{*;}</option>
						<option>-keep class
							com.bstek.urule.runtime.KnowledgePackageWrapper{*;}</option>
						<option>-keep class com.bstek.urule.console.URuleServlet {public protected *;}</option>
						<option>-keep class com.bstek.urule.console.editor.jar.JarCacheAdapter{public *;}</option>
						<option>-keep class com.bstek.urule.console.cache.packet.PacketCacheAdapter{public *;}</option>
						<option>-keep class com.bstek.urule.console.cache.ServerCacheManager{public *;}</option>
						<option>-keepclassmembernames class *{public *;}</option>
					</options>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>net.sf.proguard</groupId>
						<artifactId>proguard-base</artifactId>
						<version>6.2.2</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>
	<licenses>
		<license>
			<name>The Bstek Commercial License</name>
			<url></url>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Gaojie</name>
			<email>jacky.gao@bstek.com</email>
			<organization>Bstek</organization>
			<organizationUrl>http://www.bstek.com</organizationUrl>
		</developer>
		<developer>
			<name>JiangWeiqun</name>
			<email>william.jiang@bstek.com</email>
			<organization>Bstek</organization>
			<organizationUrl>http://www.bstek.com</organizationUrl>
		</developer>
	</developers>
	<scm>
		<connection>https://gitee.com/youseries/urule-pro.git</connection>
		<developerConnection>https://gitee.com/youseries/urule-pro.git</developerConnection>
		<url>https://gitee.com/youseries/urule-pro</url>
	</scm>
	<organization>
		<name>Bstek</name>
		<url>http://www.bstek.com</url>
	</organization>
	<name>URule Professional Console Project</name>
	<url>https://gitee.com/youseries/urule-pro/tree/master/urule-core-pro</url>
	<description>URule Commercial Version</description>
</project>